# 知枢 (DocuMind) 环境变量模板 —— 复制为 .env 后填入真实值
# Windows: 复制本文件并改名 .env，或用 `copy .env.example .env`

# ---- DeepSeek 大模型（对话 / 工具调用）----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- MySQL（阶段② query_db 工具 + 阶段⑤ 会话存储）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=xxx
MYSQL_DB=documind
