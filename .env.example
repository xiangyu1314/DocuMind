# 知枢 (DocuMind) 环境变量模板 —— 复制为 .env 后填入真实值
# Windows: 复制本文件并改名 .env，或用 `copy .env.example .env`

# ---- DeepSeek 大模型（对话 / 工具调用）----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 后续阶段占位（用到时再填）----
# 阶段③ RAG 向量库（本地 Docker）
# QDRANT_URL=http://localhost:6333
# 阶段⑤ 会话存储
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=xxx
# MYSQL_DB=documind
